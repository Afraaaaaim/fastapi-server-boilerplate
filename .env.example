# Server
PORT=8080
ENV=development
WORKERS=1

# Logging
# LOG_LEVEL: debug | info | warning | error
LOG_LEVEL=info
# LOG_FORMAT: text | json
LOG_FORMAT=text
# LOG_FILE: leave empty for stdout
LOG_FILE=

# Auth
# Comma-separated API keys, leave empty to disable auth
API_KEYS=secret-key-1,secret-key-2

# Rate limiting (slowapi format)
RATE_LIMIT=100/minute

# OpenTelemetry
# Leave empty to disable
OTLP_ENDPOINT=
SERVICE_NAME=fastapi-server-boilerplate

# Docs
# Disable Swagger UI in production
DOCS_ENABLED=true